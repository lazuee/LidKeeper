<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.lidkeeper</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Applications/LidKeeper.app/Contents/MacOS/LidKeeper</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<!-- Restart after a crash, but not after a deliberate Quit. -->
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<!-- Back off instead of hot-looping if the app dies on launch. -->
	<key>ThrottleInterval</key>
	<integer>10</integer>
</dict>
</plist>